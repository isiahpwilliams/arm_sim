<!-- Franka Panda at the origin, +x into the workspace, +z up. The wrist camera,
     TCP site, and gripper gains are added from Python (arm_env.py) so the vendored
     panda.xml stays untouched. -->
<mujoco model="panda_cube_workspace">
  <include file="assets/franka_emika_panda/panda.xml"/>
  <!-- meshdir in the included file resolves relative to this file. -->
  <compiler meshdir="assets/franka_emika_panda/assets"/>

  <option timestep="0.002"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="table_tex" builtin="checker" mark="edge" rgb1="0.55 0.45 0.35" rgb2="0.5 0.4 0.3"
      markrgb="0.6 0.5 0.4" width="300" height="300"/>
    <material name="table_mat" texture="table_tex" texuniform="true" texrepeat="4 4" reflectance="0.1"/>
    <material name="cube_red"   rgba="0.85 0.15 0.15 1"/>
    <material name="cube_blue"  rgba="0.15 0.35 0.85 1"/>
    <material name="cube_green" rgba="0.15 0.7  0.2  1"/>
  </asset>

  <default>
    <default class="cube">
      <geom type="box" size="0.02 0.02 0.02" condim="3" friction="1 0.03 0.003"
            solref="0.01 1" mass="0.04" group="1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <light pos="1 1 1.5" dir="-0.5 -0.5 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="table" type="plane" size="2 2 0.05" material="table_mat"/>

    <camera name="front" pos="1.6 0 0.95" xyaxes="0 1 0 -0.55 0 0.83" fovy="50"/>
    <camera name="overhead" pos="0.5 0 1.7" fovy="50"/>

    <!-- Cube positions are placeholders; reset() randomises them. -->
    <body name="cube_red" pos="0.5 -0.1 0.02">
      <freejoint name="cube_red"/>
      <geom name="cube_red" class="cube" material="cube_red"/>
    </body>
    <body name="cube_blue" pos="0.5 0.1 0.02">
      <freejoint name="cube_blue"/>
      <geom name="cube_blue" class="cube" material="cube_blue"/>
    </body>
    <body name="cube_green" pos="0.6 0 0.02">
      <freejoint name="cube_green"/>
      <geom name="cube_green" class="cube" material="cube_green"/>
    </body>
  </worldbody>
</mujoco>
